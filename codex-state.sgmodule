#!name=Codex Sleep State Sugar
#!desc=Capture and reuse a validated Codex turn-state independently for every Responses model.
#!system=mac

[MITM]
hostname = %APPEND% chatgpt.com, api.openai.com

[Script]
# Optional: set policy=<URL-encoded residential-IP policy> in all three arguments; leave it empty to use current rules.
codex-state-panel = type=generic,script-path=https://raw.githubusercontent.com/tzf1003/csss/main/codex-state.js,script-update-interval=86400,timeout=5,engine=jsc,argument=model=*&blocks=10&ttl=3600&renew=600&cooldown=300&retry_base=2&retry_max=60
codex-state-request = type=http-request,pattern=^https://(chatgpt\.com/backend-api/codex|api\.openai\.com/v1)/responses(?:\?|$),script-path=https://raw.githubusercontent.com/tzf1003/csss/main/codex-state.js,script-update-interval=86400,requires-body=true,timeout=90,engine=jsc,debug=true,argument=model=*&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&retry_base=2&retry_max=60&force_http=1
codex-state-response = type=http-response,pattern=^https://(chatgpt\.com/backend-api/codex|api\.openai\.com/v1)/responses(?:\?|$),script-path=https://raw.githubusercontent.com/tzf1003/csss/main/codex-state.js,script-update-interval=86400,requires-body=false,timeout=10,engine=jsc,debug=true,argument=model=*&blocks=10&ttl=3600&renew=600&cooldown=300&timeout=20&retry_base=2&retry_max=60&force_http=1

[Panel]
Codex 292 状态 = title="Codex 292：等待采集",content="发送模型请求后，这里会显示分模型采集、复用和历史记录",style=info,script-name=codex-state-panel,update-interval=1
